{
  "name": "typesafe-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,angular \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:frontend": "ng serve --host 127.0.0.1",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json",
    "build": "ng build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "test": "node --import tsx --test --test-timeout=10000 tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:e2e",
    "test:live": "npm run build && node --env-file-if-exists=.env --import tsx scripts/jev-live.ts"
  },
  "dependencies": {
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@hono/node-server": "2.1.1",
    "@orpc/client": "2.0.0-beta.37",
    "@orpc/contract": "2.0.0-beta.37",
    "@orpc/server": "2.0.0-beta.37",
    "@orpc/tanstack-query": "2.0.0-beta.37",
    "@spartan-ng/brain": "1.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/angular-query-experimental": "5.103.1",
    "@tanstack/angular-table": "9.2.4",
    "@typesafe-ai/sdk": "0.6.0",
    "clsx": "2.1.1",
    "hono": "4.13.8",
    "luxon": "3.7.2",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
